# Google Calendar two-way sync (functions/gcal.js).
#
# COPY THIS to functions/.env.local and fill in the two secret values there.
# .env.local is gitignored; never put a real client secret in this file.
#
# All of gcal's exports no-op while GCAL_CLIENT_ID / GCAL_CLIENT_SECRET /
# GCAL_REDIRECT_URI are unset, so the app deploys and runs fine without them.

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=

# Must EXACTLY match an "Authorized redirect URI" on that OAuth client, and the
# origin the app is served from — the client sends window.location.origin +
# /settings/calendar and the server rejects any mismatch.
#   local emulator : http://localhost:5176/settings/calendar
#   production     : https://support.sparkmanage.com/settings/calendar
GCAL_REDIRECT_URI=http://localhost:5176/settings/calendar

# Public HTTPS URL of the gcalWebhook function. Google will not deliver push
# notifications to localhost or to plain http, so leave this EMPTY for local
# runs — outbound sync still works, inbound changes just won't arrive.
#   production : https://us-central1-spark-support-28ed9.cloudfunctions.net/gcalWebhook
GCAL_WEBHOOK_URL=

GCAL_TIME_ZONE=America/Chicago
APP_URL=http://localhost:5176
