# Loaded only by `npx vite --mode emulator`, for local walkthroughs against the
# Firebase Emulator Suite. It points the client at localhost emulators instead
# of the real spark-support project, so nothing here can touch production data.
#
# The config values are deliberately fake: the emulators accept any project id
# and ignore the API key entirely. If these were real, a mis-set flag could
# reach production — fake values mean a misconfiguration fails loudly instead.
#
# The wiring behind VITE_USE_EMULATORS is gated on import.meta.env.DEV (see
# src/lib/firebase.ts), which Vite replaces with a literal false in any
# production build, so the branch is stripped from the shipped bundle.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=spark-support-28ed9
VITE_FIREBASE_STORAGE_BUCKET=spark-support-28ed9.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-0000000000
