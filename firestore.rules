rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && (role() == 'admin' || role() == 'superadmin');
    }

    function hasOnboardingAccess() {
      return isSignedIn() && (
        role() == 'superadmin' ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.onboardingAccess == true
      );
    }

    // True if the signed-in user is a participant of the given ticket. Used to
    // gate comments / audit events to the people who can see the ticket itself.
    function isTicketParticipant(ticketId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.participants.hasAny([request.auth.uid]);
    }

    match /profiles/{userId} {
      allow read: if isSignedIn();
      // Roles are assigned server-side: the `ensureProfile` Cloud Function (Admin
      // SDK, bypasses these rules) creates/heals profiles on sign-in, and
      // superadmins manage the team. Clients may NOT create their own profile or
      // change `role` — this closes the self-elevation hole where any signed-in
      // user could set role:'superadmin' on their own doc.
      allow create: if isSuperAdmin();
      // A user may edit their own non-role fields (e.g. name); role must be
      // unchanged. Superadmins may change anything.
      allow update: if isSuperAdmin()
        || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      // Pre-registration dup cleanup now happens server-side in ensureProfile,
      // so only superadmins delete profiles.
      allow delete: if isSuperAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (
        resource.data.participants.hasAny([request.auth.uid]) || isAdmin()
      );
      // Only superadmins may future-date a ticket (status 'Scheduled'); anyone
      // may create a normal ticket.
      allow create: if isSignedIn() &&
        (request.resource.data.status != 'Scheduled' || isSuperAdmin());
      allow update: if isAdmin();
      // Superadmins can delete any ticket (this also covers cancelling a
      // not-yet-live scheduled ticket).
      allow delete: if isSuperAdmin();
    }

    match /comments/{commentId} {
      // Comments are visible only to the ticket's participants and admins,
      // mirroring the tickets read rule — not to anyone who can guess an id.
      allow read: if isAdmin() || isTicketParticipant(resource.data.ticketId);
      // The author must be themselves AND able to see the ticket they comment on.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (isAdmin() || isTicketParticipant(request.resource.data.ticketId));
      // The author may edit their own comment, but only its editable fields:
      // the owner, ticket, and original timestamp are pinned so an edit can't
      // reassign authorship, move the comment, or backdate it.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.ticketId == resource.data.ticketId
        && request.resource.data.createdAt == resource.data.createdAt;
      // Superadmins may delete any comment; authors may delete their own.
      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Audit log for ticket lifecycle events. Created by clients but only
    // readable by admins (who can see analytics). Never edited or deleted.
    match /ticketEvents/{eventId} {
      allow read: if isAdmin();
      // The actor must be themselves AND involved in the ticket, so users can't
      // forge audit events for arbitrary tickets and skew analytics.
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && (isAdmin() || isTicketParticipant(request.resource.data.ticketId));
      allow update, delete: if false;
    }

    match /requestTypes/{typeId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /meta/{docId} {
      allow read: if isSignedIn();
      // The only doc here is the ticket counter. Allow initial create and a
      // strictly monotonic increment so a signed-in user can't rewrite it
      // backwards and cause ticket-ID collisions.
      allow create: if isSignedIn() && request.resource.data.count is int;
      allow update: if isSignedIn() && request.resource.data.count is int
        && request.resource.data.count > resource.data.count;
      allow delete: if false;
    }

    // Property onboarding. The split is deliberate: superadmins own the shape of
    // the work — the master template and the property records themselves — while
    // anyone granted onboarding access works the checklists day to day, so task
    // status, notes, dates and responsibility are writable by the whole group.
    match /onboardingTemplate/{itemId} {
      allow read: if hasOnboardingAccess();
      allow write: if isSuperAdmin();
    }

    match /onboardingProperties/{propertyId} {
      allow read: if hasOnboardingAccess();
      allow write: if isSuperAdmin();
    }

    match /onboardingTasks/{taskId} {
      allow read, write: if hasOnboardingAccess();
    }

    // Email trigger queue (Firebase Trigger Email extension). All sends now come
    // from Firestore-triggered Cloud Functions (onTicketCreated/Updated,
    // onCommentCreated, reminders, activation) using the Admin SDK, so clients
    // have no access — closing the open-relay surface.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
